{
  "name": "wordcodeaddin",
  "version": "1.1.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ReyHatsat/WordCodeAddin.git"
  },
  "license": "MIT",
  "config": {
    "app_to_debug": "word",
    "app_type_to_debug": "desktop",
    "dev_server_port": 3000
  },
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "build": "webpack --mode production",
    "build:dev": "webpack --mode development",
    "dev-server": "webpack serve --mode development",
    "lint": "office-addin-lint check",
    "lint:fix": "office-addin-lint fix",
    "prettier": "office-addin-lint prettier",
    "signin": "office-addin-dev-settings m365-account login",
    "signout": "office-addin-dev-settings m365-account logout",
    "start": "office-addin-debugging start appPackage/manifest.json --no-debug",
    "start:desktop": "office-addin-debugging start appPackage/manifest.json desktop --no-debug",
    "start:desktop:word": "office-addin-debugging start appPackage/manifest.json desktop --app word --no-debug",
    "start:web": "office-addin-debugging start appPackage/manifest.json web --no-debug",
    "stop": "office-addin-debugging stop appPackage/manifest.json",
    "validate": "office-addin-manifest validate appPackage/manifest.json",
    "watch": "webpack --mode development --watch",
    "test": "node --test tests/*.test.cjs",
    "typecheck": "tsc --noEmit",
    "signin:browser": "node scripts/office-browser-auth.cjs signin",
    "start:desktop:word:browser": "node scripts/office-browser-auth.cjs start",
    "debug:desktop:word": "office-addin-debugging start appPackage/manifest.json desktop --app word",
    "check": "npm run typecheck && npm run lint && npm test && npm run build && npm run validate && npm run package",
    "package": "office-addin-manifest export --manifest dist/manifest.json --output dist/wordcodeaddin.zip"
  },
  "dependencies": {
    "core-js": "^3.36.0",
    "highlight.js": "^11.12.0",
    "regenerator-runtime": "^0.14.1"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-typescript": "^7.23.3",
    "@types/office-js": "^1.0.377",
    "@types/office-runtime": "^1.0.35",
    "babel-loader": "^9.1.3",
    "copy-webpack-plugin": "^14.0.0",
    "eslint-plugin-office-addins": "^3.0.2",
    "file-loader": "^6.2.0",
    "html-loader": "^5.0.0",
    "html-webpack-plugin": "^5.6.0",
    "office-addin-cli": "^2.0.9",
    "office-addin-debugging": "^6.1.1",
    "office-addin-dev-certs": "^2.0.9",
    "office-addin-lint": "^3.0.9",
    "office-addin-manifest": "^2.1.5",
    "office-addin-prettier-config": "^2.0.4",
    "os-browserify": "^0.3.0",
    "process": "^0.11.10",
    "source-map-loader": "^5.0.0",
    "ts-loader": "^9.5.1",
    "typescript": "^5.4.2",
    "webpack": "^5.90.3",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^6.0.0"
  },
  "prettier": "office-addin-prettier-config",
  "browserslist": [
    "last 2 versions",
    "ie 11"
  ]
}
